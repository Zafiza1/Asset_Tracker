{
  "expo": {
    "name": "Asset Tracker Scanner",
    "slug": "asset-tracker-scanner",
    "version": "1.0.0",
    "scheme": "assettracker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assettracker.scanner"
    },
    "android": {
      "package": "com.assettracker.scanner",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera dipakai untuk memindai barcode aset.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "45b9c1ad-4352-4d78-abf3-adb232c21d35"
      }
    }
  }
}

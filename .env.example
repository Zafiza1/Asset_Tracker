# Application
APP_NAME="Asset Tracker PaaS"
APP_ENV=local
# Required. Also encrypts integration and webhook secrets at rest — keep it
# stable; when rotating, list the old key in APP_PREVIOUS_KEYS.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Let any signed-in user create an organization (self-service onboarding)
PLATFORM_SELF_SERVICE_ORGANIZATIONS=true
APP_TIMEZONE=UTC

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=asset_tracker
DB_USERNAME=asset_tracker
DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue
QUEUE_CONNECTION=redis

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Ports (the API is served through nginx at /api)
FRONTEND_PORT=5173
NGINX_PORT=80
NGINX_SSL_PORT=443
DB_PORT=5432
REDIS_PORT=6379

# Frontend: the browser calls same-origin /api
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://nginx

# Dashboard: tracked assets not seen for this long count as offline
PLATFORM_OFFLINE_AFTER_MINUTES=60

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173
SESSION_DOMAIN=localhost

# Mail (for development)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@assettracker.local"
MAIL_FROM_NAME="${APP_NAME}"

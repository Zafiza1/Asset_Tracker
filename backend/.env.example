APP_NAME="Asset Tracker Enterprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Runtime connection: non-owner role, subject to Row-Level Security.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=asset_tracker_v1
DB_USERNAME=ate_app
DB_PASSWORD=
# Owner connection: used ONLY for migrations/seeding (php artisan migrate --database=pgsql_owner).
# In production, provide these only to the deployment step, not to the running app.
DB_OWNER_USERNAME=ate_owner
DB_OWNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial platform administrator (seeded only when both are set; never commit real values).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Password for demo users created by DemoSeeder (local/staging only). Leave empty to generate one.
DEMO_PASSWORD=
